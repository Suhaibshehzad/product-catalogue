# Server
PORT=3000
# Loopback only. Use 0.0.0.0 to reach the backend from a physical device on your network.
HOST=127.0.0.1

# Product data source
FAKESTORE_BASE_URL=https://fakestoreapi.com
PRODUCT_CACHE_TTL_SECONDS=300

# Owner-chosen "top rated" products shown on the home page, in display order
FEATURED_PRODUCT_IDS=3,5,11,12,18

# Enquiries — defaults point at a local Mailpit instance (http://localhost:8025)
SALES_INBOX=sales@example.com
MAIL_FROM="Catalogue <no-reply@example.com>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
